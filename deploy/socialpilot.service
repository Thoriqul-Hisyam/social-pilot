[Unit]
Description=SocialPilot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=socialpilot
WorkingDirectory=/opt/socialpilot
EnvironmentFile=/opt/socialpilot/.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning scripts/start.mjs
Restart=always
RestartSec=5

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/socialpilot/data

[Install]
WantedBy=multi-user.target
