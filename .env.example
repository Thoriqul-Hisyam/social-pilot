# --- Meta / Threads app ---------------------------------------------------
# From developers.facebook.com -> your app -> Threads API -> Settings
META_THREADS_APP_ID=
META_THREADS_APP_SECRET=***

# Must match "URL Callback Alihkan" in the Meta dashboard exactly.
# Threads requires HTTPS; only real domains work, not LAN IPs.
THREADS_REDIRECT_URI=https://yourdomain.com/api/auth/threads/callback

# Public origin of the dashboard, used for the redirect after connecting.
# Optional: defaults to the origin of THREADS_REDIRECT_URI. Open the dashboard
# on this same domain when connecting an account, or the login cookie is missing.
PUBLIC_APP_URL=https://yourdomain.com

# --- Cloudflare R2 (required for image posts) -----------------------------
# Images are copied here before Threads fetches them: news CDNs often block
# Meta's fetcher, which Threads reports as code 1 "An unknown error".
# dash.cloudflare.com -> R2 -> Manage API tokens: Object Read & Write, this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=socialpilot-media
# Public origin of the bucket, no trailing slash: its custom domain (preferred)
# or the r2.dev URL (rate-limited, testing only).
R2_PUBLIC_URL=https://media.yourdomain.com

# --- Facebook Page (optional, not wired yet) ------------------------------
META_FACEBOOK_APP_ID=
META_FACEBOOK_APP_SECRET=***

# --- Secrets --------------------------------------------------------------
# Generate each with: openssl rand -base64 48
# ENCRYPTION_KEY encrypts stored access tokens. Changing it makes every
# stored token unreadable and all accounts must reconnect.
ENCRYPTION_KEY=
SESSION_SECRET=***

# Dashboard login password (min 8 chars).
DASHBOARD_PASSWORD=***

# Bearer key for the cron worker: Authorization: Bearer ***
API_KEY=

# --- Runtime --------------------------------------------------------------
DATABASE_PATH=./data/socialpilot.db
NODE_ENV=production
PORT=3000
