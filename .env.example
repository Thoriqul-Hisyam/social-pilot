# --- Meta / Threads app ---------------------------------------------------
# From developers.facebook.com -> your app -> Threads API -> Settings
META_THREADS_APP_ID=
META_THREADS_APP_SECRET=***

# Must match "URL Callback Alihkan" in the Meta dashboard exactly.
# Threads requires HTTPS; only real domains work, not LAN IPs.
THREADS_REDIRECT_URI=https://yourdomain.com/api/auth/threads/callback

# --- Facebook Page (optional, not wired yet) ------------------------------
META_FACEBOOK_APP_ID=
META_FACEBOOK_APP_SECRET=***

# --- Secrets --------------------------------------------------------------
# Generate each with: openssl rand -base64 48
# ENCRYPTION_KEY encrypts stored access tokens. Changing it makes every
# stored token unreadable and all accounts must reconnect.
ENCRYPTION_KEY=
SESSION_SECRET=***

# Dashboard login password (min 8 chars).
DASHBOARD_PASSWORD=***

# Bearer key for the cron worker: Authorization: Bearer ***
API_KEY=

# --- Runtime --------------------------------------------------------------
DATABASE_PATH=./data/socialpilot.db
NODE_ENV=production
PORT=3000
